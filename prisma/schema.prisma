// ============================================================
// STOCKEADO PRO — ESQUEMA DE BASE DE DATOS
// ============================================================
// Para agregar una tabla nueva: la escribís acá abajo y corrés
// `npm run migrate`. Prisma genera la migración sola, no hace
// falta escribir SQL. Ver CONTRIBUTING.md sección "Agregar un módulo".
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // en dev local podés usar "sqlite" cambiando esta línea + DATABASE_URL="file:./dev.db"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// MULTI-COMERCIO: todo cuelga de Comercio. Cada cliente tuyo
// (cada negocio al que le vendas el sistema) es un registro acá,
// con sus propios usuarios, productos, ventas, etc. totalmente
// aislados del resto.
// ------------------------------------------------------------
model Comercio {
  id          String   @id @default(cuid())
  nombre      String
  razonSocial String?
  cuit        String?
  direccion   String?
  plan        String   @default("basico") // "basico" | "pro" — controla feature flags, ver features.config.js
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  usuarios    Usuario[]
  productos   Producto[]
  clientes    Cliente[]
  ventas      Venta[]
  movStock    MovimientoStock[]
  movCaja     MovimientoCaja[]
  sesionesCaja SesionCaja[]
  presupuestos Presupuesto[]
  remitos     Remito[]
  proveedores Proveedor[]
  gastos      Gasto[]
  vendedores  Vendedor[]
  pedidos     Pedido[]

  @@map("comercios")
}

model Usuario {
  id           String   @id @default(cuid())
  comercioId   String
  comercio     Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  nombre       String
  rol          String   @default("operador") // definido en roles.config.js, no hardcodeado en lógica
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  @@unique([comercioId, email])
  @@map("usuarios")
}

model Producto {
  id           String   @id @default(cuid())
  comercioId   String
  comercio     Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  sku          String?
  nombre       String
  categoria    String?
  precio       Decimal  @db.Decimal(12, 2)
  costo        Decimal? @db.Decimal(12, 2)
  stock        Decimal  @default(0) @db.Decimal(12, 3)
  stockMinimo  Decimal? @db.Decimal(12, 3)
  ivaAlicuota  Decimal  @default(21) @db.Decimal(5, 2)
  activo       Boolean  @default(true)
  camposExtra  Json     @default("{}") // acá viven los campos custom definidos en fields.config.js — sin migración
  imagen       String?  @db.Text // imagen del producto como data URI base64, ya redimensionada en el navegador
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  movStock     MovimientoStock[]
  ventaItems   VentaItem[]

  @@unique([comercioId, sku])
  @@index([comercioId])
  @@map("productos")
}

model MovimientoStock {
  id          String   @id @default(cuid())
  comercioId  String
  comercio    Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id])
  tipo        String   // "entrada" | "salida" | "ajuste" | "venta"
  cantidad    Decimal  @db.Decimal(12, 3)
  motivo      String?
  usuarioId   String?
  fecha       DateTime @default(now())

  @@index([comercioId, productoId])
  @@map("movimientos_stock")
}

model Cliente {
  id              String   @id @default(cuid())
  comercioId      String
  comercio        Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  nombre          String
  cuitDni         String?
  condicionFiscal String   @default("Consumidor Final")
  email           String?
  telefono        String?
  direccion       String?
  camposExtra     Json     @default("{}")
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now())

  ventas          Venta[]
  presupuestos    Presupuesto[]
  remitos         Remito[]
  pedidos         Pedido[]

  @@index([comercioId])
  @@map("clientes")
}

model Venta {
  id               String   @id @default(cuid())
  comercioId       String
  comercio         Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  clienteId        String?
  cliente          Cliente? @relation(fields: [clienteId], references: [id])
  vendedorId       String?
  vendedor         Vendedor? @relation(fields: [vendedorId], references: [id])
  usuarioId        String?
  tipoComprobante  String   @default("Comprobante Interno") // "Factura A/B/C" cuando ARCA esté activo
  numero           Int
  condicionFiscal  String
  subtotal         Decimal  @db.Decimal(12, 2)
  iva21            Decimal  @default(0) @db.Decimal(12, 2)
  iva105           Decimal  @default(0) @db.Decimal(12, 2)
  iva27            Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  estadoFiscal     String   @default("interno") // "interno" | "pendiente_arca" | "emitido" | "rechazado" — ver módulo arca (fase 5)
  cae              String?
  caeVencimiento   DateTime?
  fecha            DateTime @default(now())

  items            VentaItem[]

  @@unique([comercioId, numero])
  @@index([comercioId, fecha])
  @@map("ventas")
}

model VentaItem {
  id             String   @id @default(cuid())
  ventaId        String
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     String?
  producto       Producto? @relation(fields: [productoId], references: [id])
  nombreProducto String
  cantidad       Decimal  @db.Decimal(12, 3)
  precioUnitario Decimal  @db.Decimal(12, 2)
  descuentoPct   Decimal  @default(0) @db.Decimal(5, 2)
  ivaAlicuota    Decimal  @default(21) @db.Decimal(5, 2)

  @@map("venta_items")
}

model MovimientoCaja {
  id          String   @id @default(cuid())
  comercioId  String
  comercio    Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  sesionCajaId String?
  tipo        String   // "ingreso" | "egreso"
  monto       Decimal  @db.Decimal(12, 2)
  concepto    String
  usuarioId   String?
  fecha       DateTime @default(now())

  @@index([comercioId, fecha])
  @@map("movimientos_caja")
}

model SesionCaja {
  id             String    @id @default(cuid())
  comercioId     String
  comercio       Comercio  @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  usuarioId      String
  montoApertura  Decimal   @db.Decimal(12, 2)
  montoCierre    Decimal?  @db.Decimal(12, 2)
  fechaApertura  DateTime  @default(now())
  fechaCierre    DateTime?
  estado         String    @default("abierta") // "abierta" | "cerrada"

  @@index([comercioId])
  @@map("sesiones_caja")
}

// ------------------------------------------------------------
// PRESUPUESTOS — documento sin impacto fiscal ni de stock. Se
// puede "convertir a venta" desde el módulo de ventas cuando el
// cliente lo acepta (eso descuenta stock recién en ese momento).
// ------------------------------------------------------------
model Presupuesto {
  id          String   @id @default(cuid())
  comercioId  String
  comercio    Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  numero      Int
  subtotal    Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  validoHasta DateTime?
  estado      String   @default("pendiente") // "pendiente" | "aceptado" | "rechazado" | "vencido"
  usuarioId   String?
  fecha       DateTime @default(now())

  items       PresupuestoItem[]

  @@unique([comercioId, numero])
  @@index([comercioId, fecha])
  @@map("presupuestos")
}

model PresupuestoItem {
  id             String      @id @default(cuid())
  presupuestoId  String
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  nombreProducto String
  cantidad       Decimal     @db.Decimal(12, 3)
  precioUnitario Decimal     @db.Decimal(12, 2)

  @@map("presupuesto_items")
}

// ------------------------------------------------------------
// REMITOS — comprobante de entrega de mercadería. A diferencia
// de la venta, no lleva IVA discriminado (no es un comprobante
// de cobro) pero SÍ puede mover stock si el remito es de salida.
// ------------------------------------------------------------
model Remito {
  id          String   @id @default(cuid())
  comercioId  String
  comercio    Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  numero      Int
  tipo        String   @default("entrega") // "entrega" | "devolucion"
  observaciones String?
  usuarioId   String?
  fecha       DateTime @default(now())

  items       RemitoItem[]

  @@unique([comercioId, numero])
  @@index([comercioId, fecha])
  @@map("remitos")
}

model RemitoItem {
  id             String @id @default(cuid())
  remitoId       String
  remito         Remito @relation(fields: [remitoId], references: [id], onDelete: Cascade)
  productoId     String?
  nombreProducto String
  cantidad       Decimal @db.Decimal(12, 3)

  @@map("remito_items")
}

// ------------------------------------------------------------
// PROVEEDORES
// ------------------------------------------------------------
model Proveedor {
  id          String   @id @default(cuid())
  comercioId  String
  comercio    Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  nombre      String
  cuit        String?
  email       String?
  telefono    String?
  direccion   String?
  rubro       String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  gastos      Gasto[]

  @@index([comercioId])
  @@map("proveedores")
}

// ------------------------------------------------------------
// GASTOS — egresos que no son de caja diaria (alquiler, compra a
// proveedor, servicios). Distinto de MovimientoCaja: esto es
// contable/histórico, no mueve el efectivo de la sesión de caja.
// ------------------------------------------------------------
model Gasto {
  id           String     @id @default(cuid())
  comercioId   String
  comercio     Comercio   @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  proveedorId  String?
  proveedor    Proveedor? @relation(fields: [proveedorId], references: [id])
  concepto     String
  categoria    String?
  monto        Decimal    @db.Decimal(12, 2)
  usuarioId    String?
  fecha        DateTime   @default(now())

  @@index([comercioId, fecha])
  @@map("gastos")
}

// ------------------------------------------------------------
// VENDEDORES — para tracking de comisiones. Distinto de Usuario:
// un vendedor no necesariamente tiene login al sistema.
// ------------------------------------------------------------
model Vendedor {
  id          String   @id @default(cuid())
  comercioId  String
  comercio    Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  nombre      String
  comisionPct Decimal  @default(0) @db.Decimal(5, 2)
  telefono    String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  ventas      Venta[]

  @@index([comercioId])
  @@map("vendedores")
}

// ------------------------------------------------------------
// PEDIDOS — encargo de un cliente que todavía no se cobró ni se
// entregó (ej: "reservame 3 de estos para el viernes"). Cuando se
// entrega y cobra, se resuelve como una Venta aparte — el pedido
// solo trackea la promesa, no mueve stock ni caja por sí mismo.
// ------------------------------------------------------------
model Pedido {
  id            String   @id @default(cuid())
  comercioId    String
  comercio      Comercio @relation(fields: [comercioId], references: [id], onDelete: Cascade)
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id])
  numero        Int
  estado        String   @default("pendiente") // "pendiente" | "preparando" | "listo" | "entregado" | "cancelado"
  fechaEntrega  DateTime?
  observaciones String?
  total         Decimal  @db.Decimal(12, 2)
  usuarioId     String?
  fecha         DateTime @default(now())

  items         PedidoItem[]

  @@unique([comercioId, numero])
  @@index([comercioId, fecha])
  @@map("pedidos")
}

model PedidoItem {
  id             String @id @default(cuid())
  pedidoId       String
  pedido         Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  nombreProducto String
  cantidad       Decimal @db.Decimal(12, 3)
  precioUnitario Decimal @db.Decimal(12, 2)

  @@map("pedido_items")
}
